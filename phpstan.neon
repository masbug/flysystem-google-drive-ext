parameters:
    level: 5
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Google\Service\Drive\DriveFile exposes API fields via magic properties (mimeType, shortcutDetails, parents, id, ...)
        - '#Access to an undefined property Google\\Service\\Drive\\DriveFile::\$[a-zA-Z]+#'
        - '#Access to an undefined property Google\\Service\\Drive\\Permission::\$[a-zA-Z]+#'
