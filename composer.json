            "email": "mitja@lxnav.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.15.2|^8.0.1",
        "league/flysystem": "^3.35.3",
        "google/apiclient": "^2.19",
        "guzzlehttp/psr7": "^2.12.3|^3.0"
    },
    "require-dev": {
